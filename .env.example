# ============================================================================
# TyJen Travel — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# `.env` is loaded automatically by src/config.ts (no extra package needed).
# ============================================================================

# --- Core server -------------------------------------------------------
# Port the HTTP server listens on.
PORT=3000

# Public base URL of this deployment. Used to build absolute links in emails
# and shareable quote links. For local dev, leave as-is.
APP_BASE_URL=http://localhost:3000

# One of: development | production
NODE_ENV=development

# --- Database ------------------------------------------------------------
# TyJen Travel ships with an embedded relational database (SQLite via Node's
# built-in node:sqlite module) so there is nothing extra to install locally.
# The same single database file is the single source of truth for every
# authorized desktop/browser that talks to this running server instance
# (they all call the one server over HTTP — no per-device database).
# Path is relative to the project root unless absolute.
DATABASE_FILE=./data/tyjen.db

# For an internet deployment behind a real Postgres instance instead of
# SQLite, see DEPLOYMENT.md "Upgrading to PostgreSQL" — this build targets
# SQLite by default because it requires zero extra services to run the demo.

# --- Session / auth secrets ----------------------------------------------
# Long random string used to sign session cookies (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Session cookie lifetime, in hours.
SESSION_TTL_HOURS=720

# Set to "true" only when serving over HTTPS in production, so cookies are
# marked Secure. Leave "false" for local http://localhost development.
COOKIE_SECURE=false

# --- Seed / demo admin account -------------------------------------------
# Used only by `npm run seed`. Change before any non-local deployment.
SEED_ADMIN_EMAIL=admin@tyjentravel.demo
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Host travel agency configuration (agent affiliation disclosure) ----
# TyJen Travel is a tool used BY an independent contractor agent who is
# affiliated with a host travel agency. These values populate the required
# disclosures shown to customers and are editable by an admin at runtime
# (Admin > Agency Settings) — these env vars only seed the initial row.
HOST_AGENCY_NAME=Sample Host Travel Group LLC
HOST_AGENCY_IATA_ARC_NUMBER=UNSET-CONTACT-YOUR-HOST-AGENCY
HOST_AGENCY_TICKETING_AUTHORITY=false
HOST_AGENCY_SUPPORT_PHONE=1-800-555-0100
HOST_AGENCY_SUPPORT_EMAIL=support@example-host-agency.demo

# --- Supplier integrations -------------------------------------------------
# TyJen Travel ships with clearly labeled DEMO adapters for flights, stays,
# and cruises so the app is fully explorable with no contracts in place.
# No live supplier credentials are configured out of the box. To connect a
# real supplier, see ADAPTERS.md for the adapter interface and the exact
# credentials/contract each integration requires, then set the matching
# variables below and flip its status in Admin > Supplier Connections.
#
# Nothing reads these yet in demo mode; they are placeholders documenting
# exactly what a future live adapter will need.

# Example: Amadeus / Sabre / Travelport style GDS or NDC flight aggregator
FLIGHTS_LIVE_PROVIDER=
FLIGHTS_LIVE_API_KEY=
FLIGHTS_LIVE_API_SECRET=
FLIGHTS_LIVE_ENV=sandbox

# Example: Expedia Rapid / Booking.com Partner / a host-agency GDS for stays
STAYS_LIVE_PROVIDER=
STAYS_LIVE_API_KEY=
STAYS_LIVE_API_SECRET=
STAYS_LIVE_ENV=sandbox

# Example: a cruise-line or cruise-aggregator API
CRUISES_LIVE_PROVIDER=
CRUISES_LIVE_API_KEY=
CRUISES_LIVE_API_SECRET=
CRUISES_LIVE_ENV=sandbox

# Cars / Activities / Rail: no adapters are connected in this build. The UI
# exposes the search screens and shows connection status honestly; see
# ADAPTERS.md for what each would require.
CARS_LIVE_PROVIDER=
ACTIVITIES_LIVE_PROVIDER=
RAIL_LIVE_PROVIDER=

# --- Payments ---------------------------------------------------------------
# TyJen Travel never stores card numbers. In this build, "Book with TyJen"
# checkout uses a MOCK payment provider (src/adapters/payments.mock.ts) that
# simulates authorize/capture/decline so the booking-safety flow (no charge
# without a confirmed supplier booking) can be demonstrated end to end
# without a real payments account. Replace with a real provider (e.g. Stripe)
# before accepting real customer payments — see DEPLOYMENT.md.
PAYMENTS_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (booking confirmations, quote-sent notices) ---------------------
# Left unset, TyJen Travel logs outbound emails to the console/EmailOutbox
# table instead of sending them, so the demo works without an email account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=TyJen Travel <no-reply@tyjentravel.demo>
